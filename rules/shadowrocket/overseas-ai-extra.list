# NAME: OverseasAIExtra
# AUTHOR: UykiZhao
# REPO: https://github.com/UykiZhao/Clash-Party-Override-Rule
# UPDATED: 2026-09-22
# PURPOSE: Overseas AI services not covered (or slowly covered) by the
#          OpenAI/Claude/Gemini rule-sets. Mirrors the overseas_ai_extra
#          inline ruleset of the Clash YAML overrides.
#          shadowrocket_special.conf routes these to the AI_EXTRA group
#          (default DIRECT; switch the group to PROXY when a service
#          rejects HK/MO accounts). The mainland shadowrocket.conf does not
#          reference this file - those domains are folded into
#          ai-supplement.list and proxied via the AI group there.

DOMAIN-SUFFIX,openrouter.ai
DOMAIN-SUFFIX,x.ai
DOMAIN-SUFFIX,grok.com
DOMAIN-SUFFIX,perplexity.ai
DOMAIN-SUFFIX,mistral.ai
DOMAIN-SUFFIX,huggingface.co
DOMAIN-SUFFIX,replicate.com
DOMAIN-SUFFIX,groq.com
DOMAIN-SUFFIX,together.ai
DOMAIN-SUFFIX,together.xyz
DOMAIN-SUFFIX,fireworks.ai
DOMAIN-SUFFIX,poe.com
DOMAIN-SUFFIX,cohere.com
DOMAIN-SUFFIX,midjourney.com
DOMAIN-SUFFIX,suno.com
DOMAIN-SUFFIX,udio.com
DOMAIN-SUFFIX,elevenlabs.io
DOMAIN-SUFFIX,cursor.sh
DOMAIN-SUFFIX,cursor.com
DOMAIN-SUFFIX,windsurf.com
DOMAIN-SUFFIX,codeium.com
DOMAIN-SUFFIX,lovable.dev
DOMAIN-SUFFIX,v0.dev
